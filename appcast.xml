            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="plain-text"><![CDATA[Major efficiency pass for busy fleets: the phone renders status at a glanceable cadence instead of once per agent event, session rows re-render only when their content changes, transcript cache writes stop comparing every cached conversation, and prefetching parks when the cache is full instead of refetching forever.
]]></description>
