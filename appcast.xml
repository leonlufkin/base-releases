        <item>
            <title>0.3.21</title>
            <pubDate>Wed, 02 Sep 2026 20:57:25 -0700</pubDate>
            <link>https://github.com/leonlufkin/base-releases/releases/tag/v0.3.21-260902204748</link>
            <sparkle:version>260902204748</sparkle:version>
            <sparkle:shortVersionString>0.3.21</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="plain-text"><![CDATA[Keeps translucency behind Base's content while foreground controls remain solid. Long and structurally dense transcript rows now render fully without per-message Show full message controls. Mac Shift-Return inserts exactly one newline; Return still sends. The existing hard payload cap and render fence remain in place.
]]></description>
            <enclosure url="https://github.com/leonlufkin/base-releases/releases/download/v0.3.21-260902204748/Base-0.3.21-260902204748-macOS.zip" length="11518307" type="application/octet-stream" sparkle:edSignature="9FqoHtkW2ivJWpCa5ZopzrRhrRPdOKVHDaW5NsBXI25qU6d+J8gE0+OHWJcozvnqD3aj8MS751djmFf1cqDzAw=="/>
