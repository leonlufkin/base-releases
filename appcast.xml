            <sparkle:shortVersionString>0.3.56</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="plain-text"><![CDATA[Preserves pending input and uncertain receipts without replay. Pending messages remain italic until context acknowledgement, with delivery details available only on demand. Includes cross-client submission fixes, faster OMP journal receipt scans, and restored iOS private-tailnet routing while preserving native authorization and exact receipt validation.
]]></description>
