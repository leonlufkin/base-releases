            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="plain-text"><![CDATA[Restores the macOS copy-confirmation checkmark and shows complete normal transcript responses instead of ellipsis previews on macOS and iOS. Also hardens transactional macOS relaunches so staged updates reopen reliably without losing deferred windows.
]]></description>
