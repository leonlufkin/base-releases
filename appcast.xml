            <sparkle:shortVersionString>0.3.3</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="plain-text"><![CDATA[Base now checks for updates every time it opens, so new releases surface immediately instead of waiting out the six-hour cadence. Update capture also reports exactly why it declines and no longer refuses when windows are deferred to other desktops or lack a resolvable display.
]]></description>
