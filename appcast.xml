            <sparkle:version>261107152800</sparkle:version>
            <sparkle:shortVersionString>0.3.66</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="plain-text"><![CDATA[Obsidian-backed notes and Markdown task workflows; unread transcript prefetch before opening chats; retained-conversation and stopped-session sidebar fixes. This macOS app release uses Base’s existing Sparkle updater and preserves chat-window restoration. CLI, daemon, and native-runner updates are provided as separate runtime assets; Sparkle installs the app only. The iOS feed is unchanged.
]]></description>
